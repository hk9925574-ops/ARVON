# ARVON AI Configuration

# The API key for your chosen AI provider
AI_API_KEY=your_api_key_here

# The model to use (e.g., gpt-4o-mini, llama3, etc.)
AI_MODEL=gpt-4o-mini

# The base URL for the API (leave blank for default OpenAI)
# For local Ollama, use: http://127.0.0.1:11434/v1
# For Groq, use: https://api.groq.com/openai/v1
AI_BASE_URL=
